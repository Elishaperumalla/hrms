# =========================================================
# ROLE HELPERS
# =========================================================

def get_user_role(user):
    return getattr(
        user,
        "role",
        None,
    )


def is_super_admin(user):
    return get_user_role(user) == "SUPER_ADMIN"


def is_hr_admin(user):
    return get_user_role(user) == "HR_ADMIN"


def is_manager(user):
    return get_user_role(user) == "MANAGER"


def is_employee(user):
    return get_user_role(user) == "EMPLOYEE"


# =========================================================
# CURRENT EMPLOYEE
# =========================================================

def get_current_employee(user):

    try:
        return user.employee_profile

    except Employee.DoesNotExist:
        return None


# =========================================================
# ATTENDANCE EMPLOYEE SCOPE
# =========================================================

def get_attendance_employee_scope(user):

    employees = Employee.objects.all()

    # -----------------------------------------------------
    # SUPER ADMIN
    # -----------------------------------------------------

    if is_super_admin(user):
        return employees

    current_employee = get_current_employee(user)

    if not current_employee:
        return employees.none()

    # -----------------------------------------------------
    # HR
    # -----------------------------------------------------

    if is_hr_admin(user):

        return employees.filter(
            company_id=current_employee.company_id
        )

    # -----------------------------------------------------
    # MANAGER
    # -----------------------------------------------------

    if is_manager(user):

        return employees.filter(
            Q(pk=current_employee.pk)
            |
            Q(
                reporting_manager=current_employee
            )
        )

    # -----------------------------------------------------
    # EMPLOYEE
    # -----------------------------------------------------

    if is_employee(user):

        return employees.filter(
            pk=current_employee.pk
        )

    return employees.none()


# =========================================================
# ATTENDANCE ACCESS
# =========================================================

def get_accessible_attendance(
    user,
    pk,
):

    employees = get_attendance_employee_scope(
        user
    )

    return get_object_or_404(
        Attendance.objects.select_related(
            "employee",
            "employee__company",
            "employee__department",
            "employee__designation",
            "employee__branch",
            "employee__work_location",
        ),
        pk=pk,
        employee__in=employees,
    )


# =========================================================
# PERMISSIONS
# =========================================================

def can_manage_attendance(user):

    return (
        is_super_admin(user)
        or is_hr_admin(user)
        or is_manager(user)
    )


def can_delete_attendance(user):

    return (
        is_super_admin(user)
        or is_hr_admin(user)
    )


# =========================================================
# DASHBOARD
# =========================================================

@login_required
def attendance_dashboard(request):

    today = timezone.localdate()

    employees = (
        get_attendance_employee_scope(
            request.user
        )
        .filter(
            employment_status=Employee.EmploymentStatus.ACTIVE
        )
    )

    total_employees = employees.count()

    today_records = (
        Attendance.objects
        .filter(
            date=today,
            employee__in=employees,
        )
        .select_related(
            "employee",
        )
    )

    present_today = today_records.filter(
        status=Attendance.Status.PRESENT
    ).count()

    absent_today = today_records.filter(
        status=Attendance.Status.ABSENT
    ).count()

    half_day_today = today_records.filter(
        status=Attendance.Status.HALF_DAY
    ).count()

    on_leave_today = today_records.filter(
        status=Attendance.Status.ON_LEAVE
    ).count()

    holiday_today = today_records.filter(
        status=Attendance.Status.HOLIDAY
    ).count()

    week_off_today = today_records.filter(
        status=Attendance.Status.WEEK_OFF
    ).count()

    late_today = today_records.filter(
        late_minutes__gt=0
    ).count()

    # -----------------------------------------------------
    # ATTENDANCE PERCENTAGE
    # -----------------------------------------------------

    attendance_percentage = 0

    if total_employees > 0:

        attendance_percentage = round(
            (
                present_today
                + (half_day_today * 0.5)
            )
            / total_employees
            * 100,
            2,
        )

    # -----------------------------------------------------
    # CURRENT USER TODAY RECORD
    # -----------------------------------------------------

    current_employee = get_current_employee(
        request.user
    )

    today_attendance = None

    if current_employee:

        today_attendance = (
            Attendance.objects
            .filter(
                employee=current_employee,
                date=today,
            )
            .first()
        )

    # -----------------------------------------------------
    # RECENT RECORDS
    # -----------------------------------------------------

    recent_records = (
        Attendance.objects
        .filter(
            employee__in=employees
        )
        .select_related(
            "employee",
            "employee__department",
            "employee__designation",
        )
        .order_by(
            "-date",
            "-created_at",
        )[:10]
    )

    return render(
        request,
        "attendance/attendance_dashboard.html",
        {
            "today": today,
            "total_employees": total_employees,
            "present_today": present_today,
            "absent_today": absent_today,
            "half_day_today": half_day_today,
            "on_leave_today": on_leave_today,
            "holiday_today": holiday_today,
            "week_off_today": week_off_today,
            "late_today": late_today,
            "attendance_percentage": attendance_percentage,
            "today_attendance": today_attendance,
            "recent_records": recent_records,
            "can_manage_attendance": can_manage_attendance(
                request.user
            ),
            "can_delete_attendance": can_delete_attendance(
                request.user
            ),
        },
    )


# =========================================================
# ATTENDANCE LIST
# =========================================================

@login_required
def attendance_list(request):

    employees = get_attendance_employee_scope(
        request.user
    )

    records = (
        Attendance.objects
        .filter(
            employee__in=employees
        )
        .select_related(
            "employee",
            "employee__department",
            "employee__designation",
        )
    )

    selected_date = request.GET.get(
        "date",
        ""
    ).strip()

    selected_status = request.GET.get(
        "status",
        ""
    ).strip()

    search = request.GET.get(
        "search",
        ""
    ).strip()

    # -----------------------------------------------------
    # DATE FILTER
    # -----------------------------------------------------

    if selected_date:

        records = records.filter(
            date=selected_date
        )

    # -----------------------------------------------------
    # STATUS FILTER
    # -----------------------------------------------------

    if selected_status:

        records = records.filter(
            status=selected_status
        )

    # -----------------------------------------------------
    # SEARCH
    # -----------------------------------------------------

    if search:

        records = records.filter(
            Q(
                employee__first_name__icontains=search
            )
            |
            Q(
                employee__last_name__icontains=search
            )
            |
            Q(
                employee__employee_id__icontains=search
            )
        )

    records = records.order_by(
        "-date",
        "employee__first_name",
        "employee__last_name",
    )

    return render(
        request,
        "attendance/attendance_list.html",
        {
            "records": records,
            "selected_date": selected_date,
            "selected_status": selected_status,
            "search": search,
            "status_choices": Attendance.Status.choices,
            "can_manage_attendance": can_manage_attendance(
                request.user
            ),
            "can_delete_attendance": can_delete_attendance(
                request.user
            ),
        },
    )


# =========================================================
# CREATE ATTENDANCE
# =========================================================

@login_required
def attendance_create(request):

    if not can_manage_attendance(
        request.user
    ):

        messages.error(
            request,
            "You are not authorized to create attendance records.",
        )

        return redirect(
            "attendance_list"
        )

    # -----------------------------------------------------
    # POST
    # -----------------------------------------------------

    if request.method == "POST":

        form = AttendanceForm(
            request.POST,
            request_user=request.user,
        )

        if form.is_valid():

            attendance = form.save()

            messages.success(
                request,
                "Attendance record created successfully.",
            )

            return redirect(
                "attendance_detail",
                pk=attendance.pk,
            )

    # -----------------------------------------------------
    # GET
    # -----------------------------------------------------

    else:

        initial = {}

        if request.GET.get("employee"):

            employee_id = request.GET.get(
                "employee"
            )

            try:

                employee = (
                    get_attendance_employee_scope(
                        request.user
                    )
                    .get(
                        pk=employee_id
                    )
                )

                initial["employee"] = employee.pk

            except Employee.DoesNotExist:
                pass

        if request.GET.get("date"):

            initial["date"] = request.GET.get(
                "date"
            )

        form = AttendanceForm(
            initial=initial,
            request_user=request.user,
        )

    return render(
        request,
        "attendance/attendance_form.html",
        {
            "form": form,
            "title": "Mark Attendance",
            "button_text": "Save Attendance",
            "is_edit": False,
        },
    )


