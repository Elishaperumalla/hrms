{% extends "base.html" %}

{% block title %}

    {% if object %}
        Edit Branch
    {% else %}
        Add Branch
    {% endif %}

    - HRMS

{% endblock %}


{% block content %}

<div class="container-fluid px-0">

    <!-- HEADER -->

    <div class="mb-4">

        <a
            href="{% url 'branch_list' %}"
            class="text-decoration-none"
        >
            <i class="bi bi-arrow-left me-1"></i>
            Back to Branches
        </a>

        <h3 class="fw-bold mt-3 mb-1">

            {% if object %}
                Edit Branch
            {% else %}
                Add Branch
            {% endif %}

        </h3>

        <p class="text-muted mb-0">
            Add or update your organization's branch information.
        </p>

    </div>


    <!-- FORM -->

    <div class="card dashboard-card">

        <div class="card-body p-4">

            <form method="POST">

                {% csrf_token %}


                {% if form.non_field_errors %}

                    <div class="alert alert-danger">
                        {{ form.non_field_errors }}
                    </div>

                {% endif %}


                <!-- BASIC INFORMATION -->

                <h6 class="fw-bold mb-3">

                    <i class="bi bi-building me-2 text-primary"></i>

                    Branch Information

                </h6>


                <div class="row">

                    <!-- COMPANY -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Company

                            <span class="text-danger">*</span>

                        </label>

                        {{ form.company }}

                        {% if form.company.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.company.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- BRANCH NAME -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">

                            Branch Name

                            <span class="text-danger">*</span>

                        </label>

                        {{ form.name }}

                        {% if form.name.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.name.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- BRANCH CODE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Branch Code
                        </label>

                        {{ form.code }}

                        {% if form.code.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.code.errors }}
                            </div>

                        {% endif %}

                        <small class="text-muted">
                            Example: TPT, HYD, BLR
                        </small>

                    </div>


                    <!-- HEAD OFFICE -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label d-block">
                            Branch Type
                        </label>

                        <div class="form-check mt-2">

                            {{ form.is_head_office }}

                            <label class="form-check-label">

                                Head Office

                            </label>

                        </div>

                    </div>


                    <!-- ACTIVE -->

                    <div class="col-md-3 mb-3">

                        <label class="form-label d-block">
                            Status
                        </label>

                        <div class="form-check mt-2">

                            {{ form.is_active }}

                            <label class="form-check-label">

                                Active

                            </label>

                        </div>

                    </div>

                </div>


                <hr class="my-4">


                <!-- CONTACT INFORMATION -->

                <h6 class="fw-bold mb-3">

                    <i class="bi bi-telephone me-2 text-primary"></i>

                    Contact Information

                </h6>


                <div class="row">

                    <!-- PHONE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Phone Number
                        </label>

                        {{ form.phone }}

                        {% if form.phone.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.phone.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- EMAIL -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Email Address
                        </label>

                        {{ form.email }}

                        {% if form.email.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.email.errors }}
                            </div>

                        {% endif %}

                    </div>

                </div>


                <hr class="my-4">


                <!-- ADDRESS -->

                <h6 class="fw-bold mb-3">

                    <i class="bi bi-geo-alt me-2 text-primary"></i>

                    Branch Address

                </h6>


                <div class="row">

                    <!-- ADDRESS -->

                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Address
                        </label>

                        {{ form.address }}

                        {% if form.address.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.address.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- CITY -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            City
                        </label>

                        {{ form.city }}

                        {% if form.city.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.city.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- STATE -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            State
                        </label>

                        {{ form.state }}

                        {% if form.state.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.state.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- COUNTRY -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Country
                        </label>

                        {{ form.country }}

                        {% if form.country.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.country.errors }}
                            </div>

                        {% endif %}

                    </div>


                    <!-- POSTAL CODE -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Postal Code
                        </label>

                        {{ form.postal_code }}

                        {% if form.postal_code.errors %}

                            <div class="text-danger small mt-1">
                                {{ form.postal_code.errors }}
                            </div>

                        {% endif %}

                    </div>

                </div>


                <hr class="my-4">


                <!-- FORM ERRORS -->

                {% if form.errors %}

                    <div class="alert alert-danger">

                        <i class="bi bi-exclamation-triangle me-2"></i>

                        Please correct the errors above and try again.

                    </div>

                {% endif %}


                <!-- BUTTONS -->

                <div class="d-flex gap-2">

                    <button
                        type="submit"
                        class="btn btn-primary"
                    >

                        <i class="bi bi-check-lg me-1"></i>

                        {% if object %}
                            Update Branch
                        {% else %}
                            Create Branch
                        {% endif %}

                    </button>


                    <a
                        href="{% url 'branch_list' %}"
                        class="btn btn-light"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

{% endblock %}