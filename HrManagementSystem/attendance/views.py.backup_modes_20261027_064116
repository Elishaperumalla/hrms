# CALENDAR
# =========================================================

@login_required
def attendance_calendar(request):

    today = timezone.localdate()

    try:
        year = int(request.GET.get("year", today.year))
        month = int(request.GET.get("month", today.month))
    except (TypeError, ValueError):
        year = today.year
        month = today.month

    if month < 1 or month > 12:
        month = today.month
        year = today.year

    first_day = date(year, month, 1)
    days_in_month = monthrange(year, month)[1]

    employees = (
        get_attendance_employee_scope(request.user)
        .filter(
            employment_status=Employee.EmploymentStatus.ACTIVE
        )
        .select_related("department", "designation")
        .order_by("first_name", "last_name")
    )

    records = (
        Attendance.objects.filter(
            employee__in=employees,
            date__year=year,
            date__month=month,
        )
        .select_related("employee")
    )

    attendance_map = {
        (record.employee_id, record.date.day): record
        for record in records
    }

    public_holidays = get_public_holidays(year)
    calendar_days = []

    for day_number in range(1, days_in_month + 1):
        current_date = date(year, month, day_number)

        holiday_name = public_holidays.get(current_date, "")
        weekend = is_weekend(current_date)

        calendar_days.append({
            "number": day_number,
            "date": current_date,
            "weekday": current_date.strftime("%a"),
            "is_today": current_date == today,
            "is_weekend": weekend,
            "is_holiday": bool(holiday_name),
            "holiday_name": holiday_name,
            "is_non_working_day": weekend or bool(holiday_name),
        })

    employee_rows = []

    for employee in employees:
        row = []

        for day in calendar_days:
            record = attendance_map.get(
                (employee.pk, day["number"])
            )

            row.append({
                "day": day,
                "record": record,
            })

        employee_rows.append({
            "employee": employee,
            "days": row,
        })

    return render(
        request,
        "attendance/attendance_calendar.html",
        {
            "year": year,
            "month": month,
            "month_name": first_day.strftime("%B"),
            "calendar_days": calendar_days,
            "employee_rows": employee_rows,
            "can_manage_attendance": can_manage_attendance(
                request.user
            ),
        },
    )

