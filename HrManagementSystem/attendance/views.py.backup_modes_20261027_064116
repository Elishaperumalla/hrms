@login_required
def attendance_report(request):

    today = timezone.localdate()

    # -----------------------------------------------------
    # MONTH / YEAR
    # -----------------------------------------------------

    try:

        month = int(
            request.GET.get(
                "month",
                today.month,
            )
        )

        year = int(
            request.GET.get(
                "year",
                today.year,
            )
        )

    except (
        TypeError,
        ValueError,
    ):

        month = today.month
        year = today.year

    if month < 1 or month > 12:

        month = today.month

    # -----------------------------------------------------
    # EMPLOYEE SCOPE
    # -----------------------------------------------------

    employees = get_attendance_employee_scope(
        request.user
    )

    # -----------------------------------------------------
    # RECORDS
    # -----------------------------------------------------

    records = Attendance.objects.filter(
        employee__in=employees,
        date__year=year,
        date__month=month,
    )

    employee_id = request.GET.get(
        "employee"
    )

    # -----------------------------------------------------
    # EMPLOYEE FILTER
    # -----------------------------------------------------

    if employee_id:

        try:

            selected_employee = employees.get(
                pk=employee_id
            )

            records = records.filter(
                employee=selected_employee
            )

        except Employee.DoesNotExist:

            employee_id = ""

    # -----------------------------------------------------
    # SUMMARY
    # -----------------------------------------------------

    summary = (
        records
        .values(
            "employee",
            "employee__employee_id",
            "employee__first_name",
            "employee__last_name",
        )
        .annotate(

            total_days=Count("id"),

            present_days=Count(
                "id",
                filter=Q(
                    status=Attendance.Status.PRESENT
                ),
            ),

            absent_days=Count(
                "id",
                filter=Q(
                    status=Attendance.Status.ABSENT
                ),
            ),

            half_days=Count(
                "id",
                filter=Q(
                    status=Attendance.Status.HALF_DAY
                ),
            ),

            leave_days=Count(
                "id",
                filter=Q(
                    status=Attendance.Status.ON_LEAVE
                ),
            ),

            holiday_days=Count(
                "id",
                filter=Q(
                    status=Attendance.Status.HOLIDAY
                ),
            ),

            week_off_days=Count(
                "id",
                filter=Q(
                    status=Attendance.Status.WEEK_OFF
                ),
            ),

            late_days=Count(
                "id",
                filter=Q(
                    late_minutes__gt=0
                ),
            ),

            total_work_hours=Sum(
                "work_hours"
            ),

            total_overtime=Sum(
                "overtime_hours"
            ),
        )
        .order_by(
            "employee__first_name",
            "employee__last_name",
        )
    )

    # -----------------------------------------------------
    # EMPLOYEE DROPDOWN
    # -----------------------------------------------------

    report_employees = (
        employees
        .filter(
            employment_status=Employee.EmploymentStatus.ACTIVE
        )
        .order_by(
            "first_name",
            "last_name",
        )
    )

    return render(
        request,
        "attendance/attendance_report.html",
        {
            "summary": summary,
            "employees": report_employees,
            "selected_month": month,
            "selected_year": year,
            "selected_employee": employee_id,
            "month_name": date(
                year,
                month,
                1,
            ).strftime("%B"),
        },
    )


