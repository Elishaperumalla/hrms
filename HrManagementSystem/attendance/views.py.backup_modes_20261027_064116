@login_required
def attendance_update(request, pk):

    if not can_manage_attendance(
        request.user
    ):

        messages.error(
            request,
            "You are not authorized to edit attendance records.",
        )

        return redirect(
            "attendance_detail",
            pk=pk,
        )

    attendance = get_accessible_attendance(
        request.user,
        pk,
    )

    if request.method == "POST":

        form = AttendanceForm(
            request.POST,
            instance=attendance,
            request_user=request.user,
        )

        if form.is_valid():

            form.save()

            messages.success(
                request,
                "Attendance record updated successfully.",
            )

            return redirect(
                "attendance_detail",
                pk=attendance.pk,
            )

    else:

        form = AttendanceForm(
            instance=attendance,
            request_user=request.user,
        )

    return render(
        request,
        "attendance/attendance_form.html",
        {
            "form": form,
            "attendance": attendance,
            "title": "Edit Attendance",
            "button_text": "Update Attendance",
            "is_edit": True,
        },
    )


# =========================================================
# DELETE ATTENDANCE
# =========================================================

@login_required
def attendance_delete(request, pk):

    if not can_delete_attendance(
        request.user
    ):

        messages.error(
            request,
            "You are not authorized to delete attendance records.",
        )

        return redirect(
            "attendance_detail",
            pk=pk,
        )

    attendance = get_accessible_attendance(
        request.user,
        pk,
    )

    if request.method != "POST":

        return HttpResponseNotAllowed(
            ["POST"]
        )

    attendance.delete()

    messages.success(
        request,
        "Attendance record deleted successfully.",
    )

    return redirect(
        "attendance_list"
    )


